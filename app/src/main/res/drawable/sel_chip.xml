<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 选中 + 聚焦 -->
    <item android:state_selected="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#334FC3F7" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- 选中 -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A4FC3F7" />
            <stroke
                android:width="2dp"
                android:color="#FF4FC3F7" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- 聚焦未选中 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke
                android:width="2dp"
                android:color="#B3FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- 普通 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0FFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#1FFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
