<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0E1218"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="48dp"
        android:paddingTop="32dp"
        android:paddingRight="48dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFF2F7FC"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/main_subtitle"
            android:textColor="#FF7E93A8"
            android:textSize="14sp" />

        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_permissions" />

        <TextView
            android:id="@+id/tv_perm_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/perm_overlay_checking"
            android:textColor="#FFB8C7D6"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_perm_usage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perm_usage_checking"
            android:textColor="#FFB8C7D6"
            android:textSize="15sp" />

        <!-- 英文文案比中文长，窄屏（1280×720 的电视约 757dp 可用宽度）会放不下，
             这里允许横向滚动：焦点走到哪个按钮，容器自动滚到哪个 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_toggle"
                    style="@style/TvButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="190dp"
                    android:text="@string/btn_overlay_off" />

                <Button
                    android:id="@+id/btn_grant_overlay"
                    style="@style/TvButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_grant_overlay" />

                <Button
                    android:id="@+id/btn_grant_usage"
                    style="@style/TvButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_grant_usage" />

                <Button
                    android:id="@+id/btn_usage"
                    style="@style/TvButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_usage" />

                <Button
                    android:id="@+id/btn_autostart"
                    style="@style/TvButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="0dp"
                    android:text="@string/btn_autostart_on" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_position" />

        <LinearLayout
            android:id="@+id/row_corners"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_tl"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/corner_tl" />

            <Button
                android:id="@+id/btn_bl"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/corner_bl" />

            <Button
                android:id="@+id/btn_tr"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/corner_tr" />

            <Button
                android:id="@+id/btn_br"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="0dp"
                android:text="@string/corner_br" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_nudge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_left"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="96dp"
                android:text="@string/nudge_left" />

            <Button
                android:id="@+id/btn_right"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="96dp"
                android:text="@string/nudge_right" />

            <Button
                android:id="@+id/btn_up"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="96dp"
                android:text="@string/nudge_up" />

            <Button
                android:id="@+id/btn_center"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_center" />

            <Button
                android:id="@+id/btn_down"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="96dp"
                android:text="@string/nudge_down" />

            <Button
                android:id="@+id/btn_step"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="0dp"
                android:text="@string/step_default" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_style" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_size_minus"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_size_minus" />

            <Button
                android:id="@+id/btn_size_plus"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_size_plus" />

            <Button
                android:id="@+id/btn_bg"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_bg_transparent" />

            <Button
                android:id="@+id/btn_lock"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="0dp"
                android:text="@string/btn_lock_off" />

        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_color" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:minWidth="64dp"
                android:singleLine="true"
                android:text="@string/label_down"
                android:textColor="#FFB8C7D6"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/palette_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:minWidth="64dp"
                android:singleLine="true"
                android:text="@string/label_up"
                android:textColor="#FFB8C7D6"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/palette_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="5dp"
            android:textColor="#FF93A7BA"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
