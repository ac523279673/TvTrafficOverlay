<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0E1218"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="32dp"
        android:paddingEnd="48dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFF2F7FC"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="桌面置顶 · 背景透明 · 上行下行实时速率"
            android:textColor="#FF7E93A8"
            android:textSize="14sp" />

        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="权限状态" />

        <TextView
            android:id="@+id/tv_perm_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="悬浮窗权限：检测中…"
            android:textColor="#FFB8C7D6"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_perm_usage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="应用流量统计权限：检测中…"
            android:textColor="#FFB8C7D6"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_toggle"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="190dp"
                android:text="开启悬浮窗" />

            <Button
                android:id="@+id/btn_grant_overlay"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="授予悬浮窗权限" />

            <Button
                android:id="@+id/btn_grant_usage"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="授予流量统计权限" />

            <Button
                android:id="@+id/btn_usage"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="应用流量排行" />

            <Button
                android:id="@+id/btn_autostart"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="0dp"
                android:text="开机自启：开" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="悬浮窗位置" />

        <LinearLayout
            android:id="@+id/row_corners"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_tl"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="左上" />

            <Button
                android:id="@+id/btn_bl"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="左下" />

            <Button
                android:id="@+id/btn_tr"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="右上" />

            <Button
                android:id="@+id/btn_br"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="0dp"
                android:text="右下" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_nudge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_left"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="96dp"
                android:text="左移" />

            <Button
                android:id="@+id/btn_right"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="96dp"
                android:text="右移" />

            <Button
                android:id="@+id/btn_up"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="96dp"
                android:text="上移" />

            <Button
                android:id="@+id/btn_center"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="居中" />

            <Button
                android:id="@+id/btn_down"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="96dp"
                android:text="下移" />

            <Button
                android:id="@+id/btn_step"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="0dp"
                android:text="步长：8dp" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="显示样式" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_size_minus"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="字号 -" />

            <Button
                android:id="@+id/btn_size_plus"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="字号 +" />

            <Button
                android:id="@+id/btn_bg"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="背景：透明" />

            <Button
                android:id="@+id/btn_lock"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="0dp"
                android:text="锁定位置：关" />

        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="文字颜色" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="下行"
                android:textColor="#FFB8C7D6"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/palette_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="上行"
                android:textColor="#FFB8C7D6"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/palette_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="5dp"
            android:textColor="#FF93A7BA"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
